# ── LLM (endpoint order: TUNESTER_LLM_PRIMARY_* then OPENAI_*) ─────
# Both slots are read from here; a slot with no base URL is skipped, so
# uncomment only the backends this machine should use. Nothing is hardcoded
# in llm.py.
TUNESTER_LLM_PRIMARY_BASE_URL=https://llm-primary.example.com/v1
TUNESTER_LLM_PRIMARY_MODEL=<model id served by that endpoint>
OPENAI_BASE_URL=https://llm-fallback.example.com/v1
OPENAI_API_KEY=<bearer key for the above>
TUNESTER_LLM_MODEL=<fallback model id>

# ── Output ────────────────────────────────────────────────────────
TUNESTER_OUTDIR=/data
TUNESTER_CACHE=/cache
# Answer-store lifetimes (all optional; defaults shown). The cache root holds
# five subtrees: fetched source bytes, finished MP3s, HTTP API answers, NNTP
# tracklist text and model verdicts. A 0 turns that class's store off, so every
# call goes to the live service again.
TUNESTER_CACHE_MAX_MB=30720
TUNESTER_LOOKUP_TTL_HOURS=72      # MusicBrainz / AcoustID / archive.org metadata
TUNESTER_SEARCH_TTL_MINUTES=60    # nzb.life / archive.org / yt-dlp listings
TUNESTER_LLM_TTL_HOURS=168        # model verdicts, keyed by endpoint+model+prompt

# ── Web ───────────────────────────────────────────────────────────
TUNESTER_WEB_HOST=0.0.0.0
TUNESTER_WEB_PORT=8102

# ── Audio content verification (optional) ─────────────────────────
# AcoustID API key (free at acoustid.org). When set, downloads, reuse-store
# hits and --seed-cache files are fingerprinted (chromaprint) and looked
# up on AcoustID; a confident identification of a DIFFERENT song or of a
# live take rejects, as does zero coverage on a MusicBrainz-catalogued
# target (TUNESTER_ACOUSTID_REQUIRE=0 downgrades that last one). Unset =
# gate off.
# TUNESTER_ACOUSTID_KEY=<acoustid api key>

# ── WireGuard (mesh tunnel; same server as sibling services) ──────
WG_PRIVATE_KEY=<wg genkey>
WG_PEER_PUBLIC_KEY=<server public key>
WG_PEER_ENDPOINT=<server-ip:port>
WG_ADDRESS=10.99.0.245/32
WG_PEER_ALLOWEDIPS=0.0.0.0/0
WG_PEER_PERSISTENT_KEEPALIVE=25
