# ── LLM (llm1 via llmhost) ──────────────────────────────────────
OPENAI_BASE_URL=https://llm1.llmhost.example.com/v1
OPENAI_API_KEY=<llm1 key>
TUNESTER_LLM_MODEL=llm1

# ── Output ────────────────────────────────────────────────────────
TUNESTER_OUTDIR=/data

# ── Web ───────────────────────────────────────────────────────────
TUNESTER_WEB_HOST=0.0.0.0
TUNESTER_WEB_PORT=8102

# ── WireGuard (example.com tunnel; same server as sibling services) ─
WG_PRIVATE_KEY=<wg genkey>
WG_PEER_PUBLIC_KEY=<server public key>
WG_PEER_ENDPOINT=<server-ip:port>
WG_ADDRESS=10.99.0.245/32
WG_PEER_ALLOWEDIPS=0.0.0.0/0
WG_PEER_PERSISTENT_KEEPALIVE=25
